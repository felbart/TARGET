# Vite exposes EVERY VITE_* value in the browser bundle. Public values ONLY.
# Dashboard Supabase > Connect: Project URL; Settings > API Keys: Publishable key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY

# Never add database passwords, access tokens, sb_secret_* or service_role here.
# Auth consumes these variables. They do NOT activate editorial remote persistence or run migrations.
# Temporary test passwords belong ONLY to ignored .env.security.local, never to VITE_* variables.
