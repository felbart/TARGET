# Copy to ROOT .env.security.local (ignored). NEVER use VITE_* for passwords.
# Create these TWO temporary confirmed users via the Supabase Dashboard, not public signup.
# Their emails must contain targetfb-security- and their 10 tables must be empty.
# Dedicated literal parser: #, $, commas and interior quotes are preserved.
# Comments must be on their own lines; never append comments after a value.
# Optional matching outer quotes are delimiters; no interpolation or unescaping.
SECURITY_EMAIL_A=yourname+targetfb-security-a@example.com
SECURITY_PASSWORD_A=REPLACE_LOCALLY
SECURITY_EMAIL_B=yourname+targetfb-security-b@example.com
SECURITY_PASSWORD_B=REPLACE_LOCALLY
